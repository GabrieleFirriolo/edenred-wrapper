# Configurazione locale del gateway Edenred.
# Copiala in config.env (escluso da git; lo fa la skill /edenred). Niente password qui: mai.

# Indirizzo che usi per entrare nel Portale Clienti Edenred (lato azienda).
PORTAL_URL=

# Domini a cui il browser può collegarsi, separati da virgola.
# Vuoto = ricavato da PORTAL_URL (es. clienti.edenred.it -> edenred.it).
# Aggiungi qui il dominio della pagina di login se è diverso.
ALLOWED_HOSTS=

# Richieste innocue che possono passare senza approvazione (regex, separate da virgola).
# Lascialo vuoto finché non hai letto ~/.edenred-gateway/mutations.log.
# MAI inserire conferma ordine, pagamenti o modifiche anagrafiche.
ALLOW_PATTERNS=

# 1 = apre da solo la pagina approvazioni e manda una notifica macOS.
APPROVAL_OPEN=1

# 1 = browser invisibile. Consigliato 0: vedi cosa fa l'agente e fai login lì.
HEADLESS=0

# 1 = registra il traffico in ~/.edenred-gateway/har/ (per sviluppare la versione API).
# Contiene cookie e dati dei dipendenti: attivalo solo per le prove, poi rimettilo vuoto.
RECORD_HAR=

# Opzionale: webhook Slack per ricevere le richieste da approvare.
NOTIFY_WEBHOOK=
